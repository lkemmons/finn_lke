#!/bin/bash
#PBS -N finnpy_nrt
#PBS -A P19010000
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=32G
#PBS -l walltime=1:00:00
#PBS -q casper
#PBS -j oe

# /glade/work/emmons/FINN_python/FINNv2.9nrt/run_finnpy_nrt_daily.pbs
# called by casper cronjob script: cron_run_finnpy_nrt.sh

module load conda
conda activate npl-2026a

set -euo pipefail

export TMPDIR=/glade/derecho/scratch/emmons/tmp_finn
mkdir -p $TMPDIR

# -- EDIT --
# Paths for input:
FINN_PY_ROOT=/glade/work/emmons/FINN_python/FINNv2.9nrt/finn_py
AF_ROOT=/glade/derecho/scratch/emmons/finnpy_inputs/ActiveFires
RASTER_DIR=/glade/derecho/scratch/emmons/finnpy_inputs/finn_rasters_global
# Paths for output:
WORK_DIR=/glade/derecho/scratch/emmons/finn2.9nrt_work
OUT_DIR=/glade/derecho/scratch/emmons/finn2.9nrt_output
LOG_DIR=${OUT_DIR}/logs

# vegetation map year
YEAR_RST=2024

# include tropical fire points from previous day
TROPICAL_CARRYOVER="--tropical-carryover"

# run for yesterday and use 2 days ago to fill in Tropics
offset1=-1
offset2=-2

date_to_process=`date +\%Y-\%m-\%d -d "+$offset1 days"`
YYYYMMDD=`date +\%Y\%m\%d -d "+$offset1 days"`
YYYYJJJ=$(date -d $date_to_process +'%Y%j')
date_prev=`date +\%Y-\%m-\%d -d "+$offset2 days"`
YYYYJJJm1=$(date -d $date_prev +'%Y%j')

# save all output in a log file
LOGFILE=${LOG_DIR}/finn_${YYYYJJJ}.log
exec > ${LOGFILE} 2>&1

echo "Processing data: $date_to_process $YYYYMMDD"
echo "day of year: $YYYYJJJ"
echo "previous day: $YYYYJJJm1"
echo "Raster year: $YEAR_RST"


# download fire counts for past 2 days
#-------------------------------------------
# Earthdata token expires 12/01/2026
EARTHDATATOKEN=eyJ0eXAiOiJKV1QiLCJvcmlnaW4iOiJFYXJ0aGRhdGEgTG9naW4iLCJzaWciOiJlZGxqd3RwdWJrZXlfb3BzIiwiYWxnIjoiUlMyNTYifQ.eyJ0eXBlIjoiVXNlciIsInVpZCI6ImxrZW1tb25zIiwiZXhwIjoxNzk2MTQ5NDc3LCJpYXQiOjE3OTA5NjU0NzcsImlzcyI6Imh0dHBzOi8vdXJzLmVhcnRoZGF0YS5uYXNhLmdvdiIsImlkZW50aXR5X3Byb3ZpZGVyIjoiZWRsX29wcyIsImFjciI6ImVkbCIsImFzc3VyYW5jZV9sZXZlbCI6M30.c0gZKiTEM4Aj715y93-fwJqffsq-gtkmlXzQmeZpyHZaJ89kOJ6LigBpzQfVOpfRnd4gQGhHKtPR_zFVMlNtliq6Q3DEvIy6IEv3ft-grYJkimLzU9yN8CHKk5xBV_mQHK4BILwobFFAySqaOFuiyeaIhHcrTUuQphx8Y1jv9EWyZ-GT7acXg6vMtKZTQPa5o4oNyYxI8fm9LnikeZe9Yl8DUIRbo3SKQ1mfp-AYcE8G0jr0IBpzBnAZfq7PlIsLa03ggGPdHTTuh8qD--j-Kujmm-5l6z2N5yG5M_Q8oluHmQJ9tubjRlYsG0pRzmrjUrW40NTQn5dAmh8vI6JgMg

#MODIS
/usr/bin/wget -nv -e robots=off -m -np -R .html,.tmp -nH --cut-dirs=7 --no-check-certificate "https://nrt4.modaps.eosdis.nasa.gov/api/v2/content/archives/FIRMS/modis-c6.1/Global/MODIS_C6_1_Global_MCD14DL_NRT_${YYYYJJJ}.txt" --header "Authorization: Bearer ${EARTHDATATOKEN}" -P $AF_ROOT -a ${LOGFILE} ||true
/usr/bin/wget -nv -e robots=off -m -np -R .html,.tmp -nH --cut-dirs=7 --no-check-certificate "https://nrt4.modaps.eosdis.nasa.gov/api/v2/content/archives/FIRMS/modis-c6.1/Global/MODIS_C6_1_Global_MCD14DL_NRT_${YYYYJJJm1}.txt" --header "Authorization: Bearer ${EARTHDATATOKEN}" -P $AF_ROOT -a ${LOGFILE} ||true

#VIIRS-NPP/SUOMI
/usr/bin/wget -nv -e robots=off -m -np -R .html,.tmp -nH --cut-dirs=7 --no-check-certificate "https://nrt3.modaps.eosdis.nasa.gov/api/v2/content/archives/FIRMS/suomi-npp-viirs-c2/Global/SUOMI_VIIRS_C2_Global_VNP14IMGTDL_NRT_${YYYYJJJ}.txt" --header "Authorization: Bearer ${EARTHDATATOKEN}" -P $AF_ROOT -a ${LOGFILE} ||true
/usr/bin/wget -nv -e robots=off -m -np -R .html,.tmp -nH --cut-dirs=7 --no-check-certificate "https://nrt3.modaps.eosdis.nasa.gov/api/v2/content/archives/FIRMS/suomi-npp-viirs-c2/Global/SUOMI_VIIRS_C2_Global_VNP14IMGTDL_NRT_${YYYYJJJm1}.txt" --header "Authorization: Bearer ${EARTHDATATOKEN}" -P $AF_ROOT -a ${LOGFILE} ||true

cd $FINN_PY_ROOT

echo "=== date $YYYYJJJ  ==="
echo "started FINN_PY: $(date -Iseconds)"
echo

python scripts/run_daily_nrt.py \
       --date         $YYYYJJJ \
       --tag-prefix   "v2.9nrt" \
       --af-root      $AF_ROOT \
       --raster-dir   $RASTER_DIR \
       --year-rst     $YEAR_RST \
       $TROPICAL_CARRYOVER \
       --work-dir     $WORK_DIR \
       --out-dir      $OUT_DIR

echo
echo "=== finished preprocessor: $(date -Iseconds) ==="

echo "=== calculate emissions $(date -Iseconds) ==="

cd /glade/work/emmons/FINN_python/FINNv2.9nrt/emis_calc
idl -e finn2_9_1_calc_emis_nrt_daily -args $YYYYJJJ $YEAR_RST
idl -e finn2_9_2_calc_emis_nrt_daily -args $YYYYJJJ $YEAR_RST
# v292 txt files written to: 
# /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/emis_txt_v2.9.2/

echo "=== zip emis txt and copy to modeling1 $(date -Iseconds) ==="

cd /glade/derecho/scratch/emmons/finn2.9.1nrt_emis_txt_zipped

cp -f /glade/derecho/scratch/emmons/finn2.9.1nrt_emis_txt/FINNv2.9*_${YYYYMMDD}.txt /glade/derecho/scratch/emmons/finn2.9.1nrt_emis_txt_zipped/
/usr/bin/gzip -f FINNv2.9*_${YYYYMMDD}.txt

rsync -avz /glade/derecho/scratch/emmons/finn2.9.1nrt_emis_txt_zipped/FINNv2.9.1_NRTmodvrs_*.gz modeling1.acom.ucar.edu:/data14a/FINN/web/finn_emis_txt/FINN2.9/txt/


echo "=== grid text files to 0.1deg $(date -Iseconds) ==="

pathgrid="/glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/emis_grid_v2.9.1/"
pathgridday="$pathgrid$YYYYMMDD"
mkdir -p $pathgridday
firelab="NRTmodvrs"
file_inp="/glade/work/emmons/FINN_python/FINNv2.9nrt/finn_nrt_grid_01.inp"

cat <<EOF > "$file_inp"
&control
fire_directory    = '/glade/derecho/scratch/emmons/finn2.9.1nrt_emis_txt/',
fire_filename(1)  = 'FINNv2.9.1_NRTmodvrs_MOZART_${YYYYMMDD}.txt', 
start_date     = '$date_to_process', 
end_date       = '$date_to_process',
output_timing  = 'daily', 
Model          = 'CAMFV', 
resol          = '0.1x0.1',
EmisType       = 'bb_surface_daily',
defaultUnits   = 'molecules/cm^2/s',
FinnVers       = '2.9.1_${firelab}',
glb2fire_map = 'CO -> CO', 'CO2 -> CO2', 'CH4 -> CH4', 'NO -> NO', 'NO2 -> NO2', 'SO2 -> SO2', 'NH3 -> NH3',
   'BIGALK -> BIGALK', 'BIGENE -> BIGENE', 'BZALD -> BZALD', 'C2H2 -> C2H2', 'C2H4 -> C2H4', 'C2H6 -> C2H6',
   'C3H6 -> C3H6', 'C3H8 -> C3H8', 'CH2O -> CH2O', 'CH3CHO -> CH3CHO', 'CH3COCH3 -> CH3COCH3',
   'CH3COCHO -> MGLY', 'CH3COOH -> CH3COOH', 'CH3OH -> CH3OH', 'C2H5OH -> CH3CH2OH', 'CRESOL -> CRESOL',
   'GLYALD -> GLYALD', 'HCOOH -> HCOOH', 'HONO -> HONO', 'HYAC -> HYAC', 'ISOP -> ISOP', 'MACR -> MACR',
   'MEK -> MEK', 'MTERP -> APIN+BPIN+LIMON+MYRC', 'APIN -> APIN', 'BPIN -> BPIN', 'LIMON -> LIMON', 
   'MYRC -> MYRC', 'MVK -> MVK', 'PHENOL -> PHENOL', 'HCN -> HCN', 'CH3CN -> CH3CN', 
   'TOLUENE -> TOLUENE', 'BENZENE -> BENZENE', 'XYLENES -> XYLENE', 'XYLOL -> XYLOL',
   'OC -> OC;aerosol', 'BC -> BC;aerosol', 'PM25 -> PM25;aerosol', 'PM10 -> PM10;aerosol',
   'pom_a4 -> 1.4*OC;aerosol', 'bc_a4 -> BC;aerosol',
   'num_bc_a4((particles/cm2/s)(molecules/mole)(g/kg)) -> 5.60298303e18*BC;aerosol',
   'num_pom_a4((particles/cm2/s)(molecules/mole)(g/kg)) -> 1.33350996e19*OC;aerosol',
   'SVOC->0.03251613*OC;aerosol', 
   'IVOC->0.045652*C3H6+0.047826*C3H8+0.032609*C2H6+0.030435*C2H4+0.06087*BIGENE+0.07826*BIGALK+0.063043*CH3COCH3+0.07826*MEK+0.047826*CH3CHO+0.032609*CH2O+0.0848*BENZENE+0.1*TOLUENE+0.1152*XYLENE'
/
EOF

cd $pathgridday
/glade/u/home/emmons/EMISSIONS/FINN/grid_finn_fire_emis_v2020/src/fire_emis < $file_inp  >& log_${firelab}_f01_$date_to_process.out

echo "=== calculate v2.9.2 emissions ==="

cd /glade/work/emmons/FINN_python/FINNv2.9nrt/emis_calc

python calc_emis_daily.py $YYYYJJJ $YEAR_RST \
       --path-inputs /glade/work/emmons/finn_inputs \
       --file-efs EFs_byGenVeg_NEIVA_MOZART_c20261022_FINNv2.9.2.csv \
       --path-in /glade/derecho/scratch/emmons/finn2.9nrt_output \
       --path-out /glade/derecho/scratch/emmons/finn2.9.2nrt_emis_py_nc

python finn_nc_to_txt.py \
	 /glade/derecho/scratch/emmons/finn2.9.2nrt_emis_py_nc/FINNv2.9.2_NRTmodvrs_MOZART-NEIVA_${YYYYMMDD}.nc \
	 -o /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/emis_txt_v2.9.2/FINNv2.9.2_NRTmodvrs_MOZART-NEIVA_nc_${YYYYMMDD}.txt \
	 --aerosols BC OC PM2.5 PM10

#python grid_emissions.py /glade/derecho/scratch/emmons/finn2.9.2nrt_emis_py_nc/FINNv2.9.2_NRTmodvrs_MOZART-NEIVA_${YYYYMMDD}.nc \
#       --out-dir /glade/derecho/scratch/emmons/finn2.9.2nrt_emis_py_grid01x01/${YYYYMMDD} \
#       --grid-resolution 0.1 0.1

# copy to modeling1
rsync -avz /glade/derecho/scratch/emmons/finn2.9.2nrt_emis_py_nc/FINNv2.9.2_NRTmodvrs_MOZART-NEIVA_*.nc modeling1.acom.ucar.edu:/data14a/FINN/web/finn_emis_txt/FINN2.9/nc/


echo "=== save files to campaign ==="
cp /glade/derecho/scratch/emmons/finn2.9.1nrt_emis_txt/FINNv2.9*_${YYYYMMDD}.txt /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/emis_txt_v2.9.1/
cp /glade/derecho/scratch/emmons/finn2.9nrt_output/out*${YYYYJJJ}*.csv /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/processedfires/
cp /glade/derecho/scratch/emmons/finn2.9.2nrt_emis_py_nc/FINNv2.9.2_NRTmodvrs_MOZART-NEIVA_${YYYYMMDD}.nc /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/emis_nc_v2.9.2/
#mkdir -p /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/emis_grid_v2.9.2/${YYYYMMDD}/
#cp /glade/derecho/scratch/emmons/finn2.9.2nrt_emis_py_grid01x01/${YYYYMMDD}/* /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/emis_grid_v2.9.2/${YYYYMMDD}/

# make sure everyone can read files
chmod -R +r /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/*
chmod -R +x $pathgrid/*
chmod -R +x /glade/campaign/acom/acom-weather/emmons/emissions_finn/finn2.9nrt/emis_grid_v2.9.2/*

echo "=== FINN2.9nrt completed $(date -Iseconds) ==="

exit 0

